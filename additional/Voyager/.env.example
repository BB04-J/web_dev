# ==========================================
# Voyager Travel Platform Environment Config
# ==========================================

# Backend Configuration (voyager-backend/.env)
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGO_URI=mongodb://127.0.0.1:27017/voyager

# JSON Web Token Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret
JWT_EXPIRES_IN=7d

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Key (Required for AI Trip Planning & Recommendations)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (voyager-frontend/.env)
VITE_API_URL=http://localhost:5000/api
